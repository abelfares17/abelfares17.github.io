---
import Layout from '../layouts/Layout.astro';
import DehazingExplorer from '../components/DehazingExplorer';
import VoxelMeshingLab from '../components/VoxelMeshingLab';
import FishSchoolSim3D from '../components/FishSchoolSim3D';
import MapsProgressiveMesh3D from '../components/MapsProgressiveMesh3D';
import SegmentationAndSystemsLab from '../components/SegmentationAndSystemsLab';
---

<Layout>
  <!-- HERO SECTION -->
  <section class="relative pt-14 pb-20 border-b border-slate-800/80 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex flex-wrap items-center gap-2 text-xs font-mono bg-slate-900/90 border border-slate-700/80 px-3.5 py-1.5 rounded-full text-cyan-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Seeking 6-Month Final-Year R&D Internship (PFE) • Available March / April 2027 • International Mobility
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1]">
            Computer Vision, <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-400 to-emerald-400">3D Graphics</span> & Scientific Computing.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
            I am <strong class="text-white">Abel Fares</strong>, a final-year Master’s-level Engineering Student at <strong class="text-white">ENSEEIHT (INP Toulouse)</strong> specializing in algorithmic computer vision, real-time 3D rendering engines, geometric modeling, and high-performance software architecture. Every project below is backed by interactive browser simulations, mathematical formulations, and verified repository benchmarks.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href="#dehazing"
              class="px-5 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-mono font-bold text-xs sm:text-sm transition shadow-lg shadow-cyan-500/20"
            >
              Explore Interactive R&D Labs ↓
            </a>
            <a
              href="https://github.com/abelfares17"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 font-mono text-xs sm:text-sm transition"
            >
              View GitHub Repositories ↗
            </a>
            <a
              href="#matrix"
              class="px-5 py-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800 text-slate-300 font-mono text-xs sm:text-sm transition"
            >
              Evidence-Bound Stack Matrix
            </a>
          </div>
        </div>

        <!-- Quick Telemetry Summary Card -->
        <div class="lg:col-span-4 bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-2xl">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-mono uppercase tracking-wider text-cyan-400">R&D Profile Telemetry</span>
            <span class="text-[11px] font-mono text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50">
              Verified Evidence
            </span>
          </div>

          <div class="space-y-3 text-xs font-mono">
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Primary R&D Focus</div>
              <div class="text-white font-semibold mt-0.5">Computer Vision • 3D Rendering • Geometric Simulation</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Core Native & Scientific Stack</div>
              <div class="text-cyan-300 font-semibold mt-0.5">C++17 • OpenCV • Eigen • OpenMP • Java/OpenGL • GLSL • Python (NumPy/SciPy)</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Current 3A Specialization</div>
              <div class="text-indigo-300 font-semibold mt-0.5">3D Inverse Problems, Photogrammetry, Progressive Mesh Compression (MAPS)</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Target Host & Mobility</div>
              <div class="text-emerald-300 font-semibold mt-0.5">R&D Labs & DeepTech Teams (Europe, UK, North America, Asia-Pacific)</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIER 1: PROJECT 01 — SINGLE IMAGE DEHAZING (C++17 / OPENCV / EIGEN / OPENMP) -->
  <section id="dehazing" class="py-20 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-cyan-500/20 border border-cyan-400/50 text-cyan-300 font-bold">
              TIER 1 — CASE STUDY 01
            </span>
            <span class="text-slate-400">C++17 • OpenCV 4 • Eigen 3 Sparse • OpenMP</span>
            <a
              href="https://github.com/abelfares17/Projet_Image"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cyan-400 hover:underline"
            >
              github.com/abelfares17/Projet_Image ↗
            </a>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
            Single-Image Haze Removal via Dark Channel Prior & Sparse Laplacian Soft Matting
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Full C++17 implementation of He et al. (CVPR 2009) atmospheric scattering inversion, enhanced with <strong>CIE L*a*b* atmospheric light estimation</strong> (median luminance <code class="text-cyan-300">L*</code> + extrapolated veil chrominance <code class="text-cyan-300">a*, b*</code> to reject warm foreground bias). Features OpenMP-parallelized construction of the sparse Matting Laplacian <code class="text-cyan-300">(L + λI)t = λt̃</code> solved with Eigen, 4× downsampling + guided-filter upsampling, Beer-Lambert depth recovery, and full O-HAZE / RESIDE evaluation suites.
          </p>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 text-xs font-mono space-y-1.5 shrink-0">
          <div class="text-slate-400 uppercase text-[10px]">Attribution & Verification</div>
          <div class="text-white"><strong>Role:</strong> Primary Author (17/20 commits, 3,618 LOC)</div>
          <div class="text-slate-300"><strong>Owned:</strong> Dark Channel, Atmospheric Light, Eigen/OpenMP Soft Matting, Metrics & Benchmarks</div>
          <div class="text-slate-400"><strong>Collaborator:</strong> M. Hourde (Scene Recovery & Initial Depth Map)</div>
        </div>
      </div>

      <!-- Mathematical Formulation Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
          <div class="text-xs font-mono text-cyan-400 uppercase mb-1">1. Koschmieder Scattering Model</div>
          <div class="text-sm font-mono text-white bg-slate-950 p-2.5 rounded border border-slate-800 my-2">
            I(x) = J(x)·t(x) + A·(1 - t(x))
          </div>
          <p class="text-xs text-slate-400">
            Relates observed hazy image <code class="text-slate-200">I(x)</code> to true scene radiance <code class="text-slate-200">J(x)</code>, global atmospheric light <code class="text-slate-200">A</code>, and medium transmission <code class="text-slate-200">t(x) = exp(-β·d(x))</code>.
          </p>
        </div>

        <div className="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
          <div class="text-xs font-mono text-indigo-400 uppercase mb-1">2. Sparse Matting Laplacian (Eigen + OpenMP)</div>
          <div class="text-sm font-mono text-white bg-slate-950 p-2.5 rounded border border-slate-800 my-2">
            (L + λI) · t = λ · t̃
          </div>
          <p class="text-xs text-slate-400">
            Eliminates block-erosion halo artifacts around depth discontinuities using Levin’s local window covariance matrix <code class="text-indigo-300">L_ij</code>, parallelized across CPU threads via OpenMP.
          </p>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
          <div class="text-xs font-mono text-emerald-400 uppercase mb-1">3. Radiance Inversion & Depth Map</div>
          <div class="text-sm font-mono text-white bg-slate-950 p-2.5 rounded border border-slate-800 my-2">
            J(x) = (I(x) - A) / max(t(x), t₀) + A
          </div>
          <p class="text-xs text-slate-400">
            Regularized by transmission floor <code class="text-slate-200">t₀ = 0.20</code> to prevent noise amplification in dense haze, with depth recovered up to scale via <code class="text-slate-200">d(x) = -ln(t)/β</code>.
          </p>
        </div>
      </div>

      <!-- Interactive Component -->
      <DehazingExplorer client:load />
    </div>
  </section>

  <!-- TIER 1: PROJECT 02 — VOXEL ENGINE (JAVA 17 / OPENGL / GLSL) -->
  <section id="voxel" class="py-20 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-indigo-500/20 border border-indigo-400/50 text-indigo-300 font-bold">
              TIER 1 — CASE STUDY 02
            </span>
            <span class="text-slate-400">Java 17 • OpenGL 3.2 Core • GLSL • LWJGL 3 • Multithreading</span>
            <a
              href="https://github.com/abelfares17/Voxel_Project"
              target="_blank"
              rel="noopener noreferrer"
              class="text-indigo-400 hover:underline"
            >
              github.com/abelfares17/Voxel_Project ↗
            </a>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
            Custom 3D Voxel Engine — Greedy Meshing, Quad Indexing & Cascaded Shadow Mapping
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            A 100% personal 3D voxel engine engineered from scratch on top of LWJGL/OpenGL. Implements worker-thread pool chunk meshing, greedy surface merging, compact vertex formatting with shared EBO quad indexing, a 3-cascade (2048²) directional shadow-mapping pipeline with light-volume caster culling, and a physically-inspired celestial day/night cycle.
          </p>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 text-xs font-mono space-y-1.5 shrink-0">
          <div class="text-slate-400 uppercase text-[10px]">Attribution & Verification</div>
          <div class="text-emerald-400 font-bold">100% Personal Project (Sole Author)</div>
          <div class="text-slate-300"><strong>Hardware Benchmarked:</strong> Apple M2 Pro (Retina 2268×1382)</div>
          <div class="text-slate-400"><strong>Measured Gain:</strong> 43.05 → 61.53 FPS (+42.9% via EBO + Compact Verts)</div>
        </div>
      </div>

      <!-- Interactive Component -->
      <VoxelMeshingLab client:visible />
    </div>
  </section>

  <!-- TIER 1: PROJECT 03 — 3D COLLECTIVE BEHAVIOR SIMULATION (PROJET_MOD_GEOM) -->
  <section id="boids" class="py-20 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-emerald-500/20 border border-emerald-400/50 text-emerald-300 font-bold">
              TIER 1 — CASE STUDY 03
            </span>
            <span class="text-slate-400">Python • NumPy Vectorization • SciPy cKDTree • Computational Geometry</span>
            <a
              href="https://github.com/abelfares17/Projet_mod_geom"
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-400 hover:underline"
            >
              github.com/abelfares17/Projet_mod_geom ↗
            </a>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
            3D Fish-School Geometric Modeling — From Aoki Zones to Topological KD-Trees & Vision Cones
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            A 5-stage scientific simulation exploring how local geometric perception rules generate macroscopic self-organization in 3D space. Compares metric interaction spheres (Aoki 1982), wave-like behavioral contagion (Trafalgar effect), scale-free topological $k$-nearest neighbor interactions accelerated via <code class="text-emerald-300">scipy.spatial.cKDTree</code>, and forward field-of-view cone filtering (<code class="text-emerald-300">np.einsum</code>). Both physics and 3D Matplotlib rendering are fully vectorized in NumPy with <code class="text-emerald-300">copy_from_bbox</code> / <code class="text-emerald-300">blit</code> acceleration.
          </p>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 text-xs font-mono space-y-1.5 shrink-0">
          <div class="text-slate-400 uppercase text-[10px]">Attribution & Optimizations</div>
          <div class="text-white"><strong>Role:</strong> Lead Author (7/8 commits + Vectorization Pass)</div>
          <div class="text-slate-300"><strong>Physics:</strong> Tensorized <code class="text-emerald-300">(N,N,3)</code> & <code class="text-emerald-300">einsum</code> vision cone</div>
          <div class="text-slate-400"><strong>Renderer:</strong> Vectorized 10-tri mesh + Matplotlib Blitting</div>
        </div>
      </div>

      <!-- Interactive Component -->
      <FishSchoolSim3D client:visible />
    </div>
  </section>

  <!-- TIER 1: PROJECT 04 — 3A RESEARCH PROJECT: MAPS PROGRESSIVE 3D MESH COMPRESSION -->
  <section id="maps" class="py-20 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-amber-500/20 border border-amber-400/50 text-amber-300 font-bold">
              TIER 1 — CASE STUDY 04 (3A RESEARCH PROJECT)
            </span>
            <span class="text-slate-400">Python • NumPy • SciPy • Computational Topology • SIGGRAPH ’98</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
            Progressive 3D Mesh Compression (`.obj` → `.obja`) via MAPS Multiresolution Hierarchy
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Implementation of the seminal <strong>MAPS (Multiresolution Adaptive Parameterization of Surfaces, Lee et al., SIGGRAPH ’98)</strong> pipeline to stream arbitrary 3D triangle meshes under a strict bitrate-distortion tradeoff. Combines Dobkin-Kirkpatrick independent-set decimation, local conformal 1-ring flattening <code class="text-amber-300">μ_u(p_jk) = r_k^a · exp(i·a·θ_k)</code>, constrained planar re-triangulation, and Loop 1:4 subdivision with bijection tracking <code class="text-amber-300">Π^l</code>.
          </p>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 text-xs font-mono space-y-1.5 shrink-0">
          <div class="text-slate-400 uppercase text-[10px]">Attribution (`maps_core/p1_hierarchy.py`)</div>
          <div class="text-white"><strong>Module Owner:</strong> Hierarchy & Geometric Priorities (P1)</div>
          <div class="text-slate-300"><strong>Key Work:</strong> Pure NumPy vectorization of w(λ, u), DK independent set, CCW 1-ring ordering & error E(t)</div>
        </div>
      </div>

      <!-- Interactive Component -->
      <MapsProgressiveMesh3D client:visible />
    </div>
  </section>

  <!-- TIER 2: SEGMENTATION, COMPILERS & SYSTEMS ENGINEERING -->
  <section id="systems" class="py-20 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3 max-w-3xl">
        <div class="flex items-center gap-3 text-xs font-mono">
          <span class="px-2.5 py-1 rounded bg-slate-800 border border-slate-700 text-cyan-300 font-bold">
            TIER 2 — VISION, COMPILERS & LOW-LEVEL SYSTEMS
          </span>
          <span class="text-slate-400">C++17 • Ada • OCaml • MATLAB • Java Concurrency</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          Image Segmentation, Bit-Level Compression & Multi-Pass Compiler Engineering
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Complementary academic and systems engineering artifacts demonstrating versatility across classical clustering/segmentation (`Traitement_Image`), binary stream encoding in Ada (`ADA_huffman_compression`), and static analysis / code generation in OCaml (`TDL`).
        </p>
      </div>

      <SegmentationAndSystemsLab client:visible />

      <!-- Additional Software & Systems Projects Compact Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-4">
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-cyan-400 mb-2">
              <span>3D Inverse Problems & Signal</span>
              <span>MATLAB</span>
            </div>
            <h4 class="text-base font-bold text-white">Photogrammetry, Total-Variation Inpainting & Active Contours (`TAV_TP` & `PI3D`)</h4>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              Practical implementations of total-variation denoising/inpainting, patch-based restoration, Gradient Vector Flow active contours, spectral audio fingerprinting, and 3A multi-view 3D reconstruction coursework.
            </p>
          </div>
          <a href="https://github.com/abelfares17/TAV_TP" target="_blank" class="mt-4 text-xs font-mono text-cyan-400 hover:underline">
            View Repository (abelfares17/TAV_TP) ↗
          </a>
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-indigo-400 mb-2">
              <span>Full-Stack Real-Time Web</span>
              <span>Spring Boot 4 / React 19</span>
            </div>
            <h4 class="text-base font-bold text-white">Multiplayer Card-Game Prototype (`Projet_Appliweb`)</h4>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              Academic local prototype supporting Coinche and Tarot with Java 21, Spring Security JWT authentication, STOMP/WebSocket state synchronization, rule-based bots, JPA/H2 persistence, and integration tests.
            </p>
          </div>
          <a href="https://github.com/b-cb/Projet_Appliweb" target="_blank" class="mt-4 text-xs font-mono text-indigo-400 hover:underline">
            View Repository (b-cb/Projet_Appliweb) ↗
          </a>
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-emerald-400 mb-2">
              <span>Graphics & Concurrency</span>
              <span>Java / Make</span>
            </div>
            <h4 class="text-base font-bold text-white">DIY Software Renderer (`UE_Computer_Graphics`) & Parallel Systems (`Sys_concurrents`)</h4>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              Extensible Java 3D software rasterizer with custom shader abstraction, wireframe/face modes, lighting and normal visualization; paired with monitor, Fork/Join, and CSP concurrency coursework.
            </p>
          </div>
          <a href="https://github.com/abelfares17/UE_Computer_Graphics" target="_blank" class="mt-4 text-xs font-mono text-emerald-400 hover:underline">
            View Repository (UE_Computer_Graphics) ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- EVIDENCE-BOUND TECHNICAL STACK MATRIX -->
  <section id="matrix" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3 max-w-3xl">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 px-3 py-1 rounded-full">
          Evidence-Bound Competency Architecture
        </div>
        <h2 class="text-3xl font-extrabold text-white">
          Verified Technical Stack Matrix
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          Every technology listed below is directly linked to public repository implementations, benchmark scripts, or technical reports.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-cyan-400">Computer Vision & Numerical C++</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">
            <li class="flex justify-between"><span>C++17 & STL Filesystem</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>OpenCV 4 & Guided Filter</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Eigen 3 Sparse Matrices</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>OpenMP Parallelization</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>PSNR / SSIM / CIEDE2000</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>K-Means & Mean-Shift</span><span class="text-cyan-400">Verified</span></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-indigo-400">3D Graphics, Rendering & Engines</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">
            <li class="flex justify-between"><span>OpenGL 3.2+ Core & VAO/EBO</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>GLSL Shaders & Cascaded Shadows</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>LWJGL 3 / GLFW / JOML</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Greedy Voxel Meshing</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Three.js / WebGL Interactive</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>MAPS 3D Mesh Compression</span><span class="text-emerald-400">High</span></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-emerald-400">Scientific Computing & Simulation</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">

---
import Layout from '../layouts/Layout.astro';
import FeaturedProjectsHub from '../components/FeaturedProjectsHub';
import SegmentationAndSystemsLab from '../components/SegmentationAndSystemsLab';
---

<Layout>
  <!-- HERO SECTION -->
  <section class="relative pt-14 pb-20 border-b border-slate-800/80 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex flex-wrap items-center gap-2 text-xs font-mono bg-slate-900/90 border border-slate-700/80 px-3.5 py-1.5 rounded-full text-cyan-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Seeking 6-Month Final-Year R&D Internship (PFE) • Available March / April 2027 • International Mobility
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1]">
            Computer Vision, <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-400 to-emerald-400">3D Graphics</span> & Scientific Computing.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
            I am <strong class="text-white">Abel Fares</strong>, a final-year Master’s-level Engineering Student at <strong class="text-white">ENSEEIHT (INP Toulouse)</strong> specializing in algorithmic computer vision, real-time 3D rendering engines, geometric modeling, and high-performance software architecture. Every project below is backed by interactive browser simulations, mathematical formulations, and verified repository benchmarks.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href="#featured-projects"
              class="px-5 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-mono font-bold text-xs sm:text-sm transition shadow-lg shadow-cyan-500/20"
            >
              Explore Primary R&D Case Studies ↓
            </a>
            <a
              href="https://github.com/abelfares17"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 font-mono text-xs sm:text-sm transition"
            >
              View GitHub Repositories ↗
            </a>
            <a
              href="#matrix"
              class="px-5 py-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800 text-slate-300 font-mono text-xs sm:text-sm transition"
            >
              Evidence-Bound Stack Matrix
            </a>
          </div>
        </div>

        <!-- Quick Telemetry Summary Card -->
        <div class="lg:col-span-4 bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-2xl">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-mono uppercase tracking-wider text-cyan-400">R&D Profile Telemetry</span>
            <span class="text-[11px] font-mono text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50">
              Verified Evidence
            </span>
          </div>

          <div class="space-y-3 text-xs font-mono">
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Primary R&D Focus</div>
              <div class="text-white font-semibold mt-0.5">Computer Vision • 3D Rendering • Geometric Simulation</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Core Native & Scientific Stack</div>
              <div class="text-cyan-300 font-semibold mt-0.5">C++17 • OpenCV • Eigen • OpenMP • Java/OpenGL • GLSL • Python (NumPy/SciPy)</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Current 3A Coursework</div>
              <div class="text-indigo-300 font-semibold mt-0.5">3D Inverse Problems, Photogrammetry, Progressive Mesh Compression (MAPS)</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80">
              <div class="text-slate-400">Target Host & Mobility</div>
              <div class="text-emerald-300 font-semibold mt-0.5">R&D Labs & DeepTech Teams (Europe, UK, North America, Asia-Pacific)</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIER 1: FEATURED R&D CASE STUDIES HUB (CARDS + EXPANDABLE DETAILS & LABS) -->
  <FeaturedProjectsHub client:load />

  <!-- TIER 2: SEGMENTATION, COMPILERS & FULL-STACK SYSTEMS -->
  <section id="systems" class="py-20 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="space-y-3 max-w-3xl">
        <div class="flex items-center gap-3 text-xs font-mono">
          <span class="px-2.5 py-1 rounded bg-slate-800 border border-slate-700 text-cyan-300 font-bold">
            TIER 2 — SYSTEMS, COMPILERS & FULL-STACK ENGINEERING
          </span>
          <span class="text-slate-400">C++17 • Ada • OCaml • Java 21 / Spring Boot 4 • React 19</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          Image Segmentation, Bit-Level Compression, Compilers & Full-Stack Systems
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Complementary systems engineering artifacts demonstrating breadth across classical segmentation (<a href="https://github.com/mhourde/Traitement_Image" target="_blank" class="text-amber-300 hover:underline"><code>Traitement_Image</code></a>), bitstream binary encoding in Ada (<a href="https://github.com/abelfares17/ADA_huffman_compression" target="_blank" class="text-emerald-300 hover:underline"><code>ADA_huffman_compression</code></a>), multi-pass compiler construction in OCaml (<a href="https://github.com/abelfares17/TDL" target="_blank" class="text-indigo-300 hover:underline"><code>TDL</code></a>), and distributed real-time web engineering (<a href="https://github.com/b-cb/Projet_Appliweb" target="_blank" class="text-cyan-300 hover:underline"><code>Projet_Appliweb</code></a>).
        </p>
      </div>

      <SegmentationAndSystemsLab client:visible />

      <!-- Full-Stack Real-Time Technical Proof: Projet_Appliweb -->
      <div class="rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-6 sm:p-8 shadow-2xl space-y-6">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-800 pb-5">
          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider text-indigo-400 bg-indigo-950/70 border border-indigo-800/60 px-3 py-1 rounded-full font-bold">
                Full-Stack Technical Proof
              </span>
              <span class="text-xs font-mono text-slate-400 bg-slate-900 px-2.5 py-1 rounded-full border border-slate-800">
                Java 21 • Spring Boot 4 • React 19 • STOMP / WebSocket
              </span>
            </div>
            <h3 class="text-2xl font-extrabold text-white tracking-tight">
              Multiplayer Real-Time Card Platform: Coinche & Tarot (<code class="text-indigo-300 font-mono text-xl">Projet_Appliweb</code>)
            </h3>
            <p class="text-sm text-slate-300 max-w-4xl leading-relaxed">
              Full-stack multiplayer gaming system supporting Coinche and Tarot with an event-driven STOMP/WebSocket synchronization architecture, stateless Spring Security JWT authentication, relational persistence, and heuristic rule-based AI bots.
            </p>
          </div>

          <a
            href="https://github.com/b-cb/Projet_Appliweb"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-mono font-bold text-xs sm:text-sm transition shadow-lg shadow-indigo-600/20 whitespace-nowrap self-start lg:self-center"
          >
            <span>View Repository (b-cb/Projet_Appliweb)</span>
            <span>↗</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Column 1: Backend & Security -->
          <div class="rounded-xl border border-slate-800/80 bg-slate-950/70 p-5 space-y-3">
            <div class="flex items-center justify-between text-xs font-mono text-indigo-400 border-b border-slate-800/60 pb-2">
              <span class="font-bold">Backend & Security</span>
              <span>Java 21 / Spring Boot 4</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Stateless JWT authentication filter (<code class="text-indigo-300">JwtAuthFilter</code>, <code class="text-indigo-300">JwtService</code>) guarding REST endpoints and STOMP handshakes.
            </p>
            <ul class="text-xs font-mono text-slate-400 space-y-1.5 pt-1">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>STOMP broker at <code class="text-slate-300">/ws</code> endpoint</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>Topic broadcast: <code class="text-slate-300">/topic/partie/&#123;id&#125;</code></span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>Spring Data JPA + H2 relational persistence</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>Integration testing with MockMvc & WebSockets</span>
              </li>
            </ul>
          </div>

          <!-- Column 2: Game Engine & AI Bots -->
          <div class="rounded-xl border border-slate-800/80 bg-slate-950/70 p-5 space-y-3">
            <div class="flex items-center justify-between text-xs font-mono text-cyan-400 border-b border-slate-800/60 pb-2">
              <span class="font-bold">Game Engine & Bots</span>
              <span>Tarot & Coinche Rules</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Deterministic state machines enforcing official card mechanics, legal trick constraints, and autonomous bot behaviors.
            </p>
            <ul class="text-xs font-mono text-slate-400 space-y-1.5 pt-1">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>Tarot for 3–5 players, Chien & Roi calls</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>Coinche: Capot, Surcoinche, Belote</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>Trump obligation & cut validation engine</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>Rule-based AI bots for solo or mixed matches</span>
              </li>
            </ul>
          </div>

          <!-- Column 3: Frontend & Real-Time Sync -->
          <div class="rounded-xl border border-slate-800/80 bg-slate-950/70 p-5 space-y-3">
            <div class="flex items-center justify-between text-xs font-mono text-emerald-400 border-b border-slate-800/60 pb-2">
              <span class="font-bold">Frontend & Live Sync</span>
              <span>React 19 / Vite 8</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Reactive table visualization with dynamic bidding overlays, interactive card hands, and sub-millisecond state updates.
            </p>
            <ul class="text-xs font-mono text-slate-400 space-y-1.5 pt-1">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>STOMP.js 7 live state subscription</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Interactive bidding panels & Chien modal</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Live in-game chat panel with broadcast</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Final contract score & Oudlers calculation</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Telemetry Tags -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800/80 text-xs font-mono text-slate-400">
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Java 21</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Spring Boot 4</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Spring Security JWT</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">STOMP / WebSocket</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">React 19</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Vite 8</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Spring Data JPA / H2</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Rule-Based AI Bots</span>
          </div>
          <a
            href="https://github.com/b-cb/Projet_Appliweb"
            target="_blank"
            rel="noopener noreferrer"
            class="text-indigo-400 hover:text-indigo-300 hover:underline transition"
          >
            Explore repository codebase ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- EVIDENCE-BOUND TECHNICAL STACK MATRIX -->
  <section id="matrix" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3 max-w-3xl">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 px-3 py-1 rounded-full">
          Evidence-Bound Competency Architecture
        </div>
        <h2 class="text-3xl font-extrabold text-white">
          Verified Technical Stack Matrix
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          Every technology listed below is directly linked to public repository implementations, benchmark scripts, or technical reports.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-cyan-400">Computer Vision & Numerical C++</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">
            <li class="flex justify-between"><span>C++17 & STL Filesystem</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>OpenCV 4 & Guided Filter</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Eigen 3 Sparse Matrices</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>OpenMP Parallelization</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>PSNR / SSIM / CIEDE2000</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>K-Means & Mean-Shift</span><span class="text-cyan-400">Verified</span></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-indigo-400">3D Graphics, Rendering & Engines</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">
            <li class="flex justify-between"><span>OpenGL 3.2+ Core & VAO/EBO</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>GLSL Shaders & Cascaded Shadows</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>LWJGL 3 / GLFW / JOML</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Greedy Voxel Meshing</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Three.js / WebGL Interactive</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>MAPS 3D Mesh Compression</span><span class="text-emerald-400">High</span></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-emerald-400">Scientific Computing & Simulation</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">
            <li class="flex justify-between"><span>Python 3 & Vectorized NumPy</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>SciPy Spatial (cKDTree)</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>3D Particle & Swarm Physics</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Computational Geometry & Mesh</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Conformal Parameterization</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Matplotlib 3D (`Poly3DCollection`)</span><span class="text-emerald-400">High</span></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 space-y-3">
          <div class="text-xs font-mono uppercase text-amber-400">Software, Compilers & Full-Stack</div>
          <ul class="space-y-2 text-xs text-slate-300 font-mono">
            <li class="flex justify-between"><span>Java 17/21 & Concurrency</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>TypeScript / React 19 / Astro 5</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Spring Boot 4 / Security / JPA</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>WebSocket / STOMP Real-Time</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>Ada Bit-Level I/O & Huffman</span><span class="text-emerald-400">High</span></li>
            <li class="flex justify-between"><span>OCaml / Menhir AST & TAM</span><span class="text-cyan-400">Verified</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
